{
  "name": "sicose-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run prisma:generate && tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "deploy:start": "npm run prisma:migrate:deploy && npm start",
    "lint": "eslint src/**/*.ts test/**/*.ts",
    "typecheck": "npm run prisma:generate && tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test",
    "seed": "tsx prisma/seed.ts",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.11.1",
    "jose": "^5.9.6",
    "morgan": "^1.10.0",
    "multer": "^2.0.1",
    "pdfkit": "^0.15.2",
    "prisma": "^5.22.0",
    "swagger-ui-express": "^5.0.1",
    "write-excel-file": "^4.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.3",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.2",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^8.57.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  }
}
