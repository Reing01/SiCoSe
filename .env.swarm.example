SICOSE_STACK_NAME=sicose
SICOSE_HTTP_PORT=80
SICOSE_PUBLIC_ORIGIN=http://sicose-practica.local
# El script deriva COOKIE_SECURE de este protocolo: false en HTTP, true en HTTPS.
# Usa 2 si hay un balanceador adicional delante del proxy edge.
SICOSE_TRUST_PROXY_HOPS=1
# SICOSE_VERIFY_URL=http://127.0.0.1:80

SICOSE_BACKEND_IMAGE=ghcr.io/reing01/sicose-backend:latest
SICOSE_FRONTEND_IMAGE=ghcr.io/reing01/sicose-frontend:latest
SICOSE_EDGE_IMAGE=ghcr.io/reing01/sicose-frontend:latest
SICOSE_BACKEND_REPLICAS=12
SICOSE_FRONTEND_REPLICAS=12
SICOSE_EDGE_REPLICAS=4

SICOSE_POSTGRES_DB=sicose_prod
SICOSE_POSTGRES_USER=sicose_user
SICOSE_POSTGRES_PASSWORD=change-me
SICOSE_JWT_SECRET=change-me-with-a-strong-secret
SICOSE_SUPABASE_URL=https://your-project.supabase.co
SICOSE_SUPABASE_SERVICE_KEY=replace-me
SICOSE_SUPABASE_STORAGE_BUCKET=comprobantes

# Solo son necesarias si las imagenes de GHCR son privadas.
GHCR_USERNAME=
GHCR_TOKEN=
GHCR_SERVER=ghcr.io
