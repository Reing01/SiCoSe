# Local Docker Compose defaults.
# These are non-production placeholders. Keep real secrets in an untracked .env
# file or your CI/CD secret manager.
POSTGRES_DB=sicose_dev
POSTGRES_USER=sicose_user
POSTGRES_PASSWORD=change-me-local-only
REDIS_APPENDONLY=yes

VITE_API_BASE_URL=http://localhost:3000
PORT=3000
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://sicose_user:change-me-local-only@postgres:5432/sicose_dev
DIRECT_URL=postgresql://sicose_user:change-me-local-only@postgres:5432/sicose_dev
REDIS_URL=redis://redis:6379
JWT_SECRET=change-me-local-only
JWT_ISSUER=sicose
JWT_EXPIRES_IN=8h
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10
RATE_LIMIT_EMAIL_WINDOW_MS=300000
RATE_LIMIT_EMAIL_MAX=5
