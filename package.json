{
  "name": "sicose",
  "version": "1.0.0",
  "description": "Sistema web para la digitalizacion y gestion de pagos de servicios publicos en Juntas Auxiliares gubernamentales del estado de Puebla.",
  "main": "electron/main.js",
  "type": "module",
  "packageManager": "npm@10.8.2",
  "scripts": {
    "build": "npm run build --prefix frontend && npm run build --prefix backend",
    "start": "npm run start --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "electron:dev": "node ./scripts/run-electron-dev.mjs",
    "desktop:dev": "concurrently -c \"cyan,magenta,green\" \"npm run dev:frontend\" \"npm run dev:backend\" \"npm run electron:dev\"",
    "desktop:build": "npm run build && electron-builder --config electron-builder.json --win nsis",
    "dev": "concurrently -c \"cyan,magenta\" \"npm run dev:frontend\" \"npm run dev:backend\"",
    "deploy:cluster:4nodos": "node ./scripts/deploy-swarm-4nodos.mjs",
    "deploy:swarm:4nodos": "node ./scripts/deploy-swarm-4nodos.mjs",
    "lint": "eslint --config eslint.config.js .",
    "typecheck": "npm run typecheck --prefix backend && npm run typecheck --prefix frontend",
    "test": "npm run test --prefix frontend && npm run test --prefix backend && npm run test:swarm",
    "test:swarm": "node --test ./scripts/swarm-deploy-utils.test.mjs",
    "test:e2e": "npm run test:e2e --prefix frontend",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Reing01/SiCoSe.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Reing01/SiCoSe/issues"
  },
  "homepage": "https://github.com/Reing01/SiCoSe#readme",
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "concurrently": "^10.0.4",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
