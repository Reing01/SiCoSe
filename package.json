{
  "name": "sicose",
  "version": "1.0.0",
  "description": "Sistema web para la digitalizacion y gestion de pagos de servicios publicos en Juntas Auxiliares gubernamentales del estado de Puebla.",
  "main": "index.js",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "pnpm --dir frontend run build && pnpm --dir backend run build",
    "start": "pnpm --dir backend run start",
    "dev:frontend": "pnpm --dir frontend run dev",
    "dev:backend": "pnpm --dir backend run dev",
    "dev": "concurrently -c \"cyan,magenta\" \"pnpm --dir frontend run dev\" \"pnpm --dir backend run dev\"",
    "deploy:cluster:4nodos": "helm upgrade --install sicose ./helm/sicose --namespace sicose-prod --create-namespace -f ./helm/sicose/values-practica-4-nodos.yaml --wait --wait-for-jobs --atomic --timeout 15m",
    "deploy:cluster:4nodos:bootstrap": "node ./scripts/deploy-cluster-4nodos.mjs",
    "lint": "pnpm --dir frontend run lint && pnpm --dir backend run lint",
    "test": "pnpm --dir frontend run test && pnpm --dir backend run test",
    "test:e2e": "pnpm --dir frontend run test:e2e",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Reing01/SiCoSe.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Reing01/SiCoSe/issues"
  },
  "homepage": "https://github.com/Reing01/SiCoSe#readme",
  "devDependencies": {
    "concurrently": "^10.0.3",
    "eslint": "^8.57.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "typescript": "^5.8.3"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
