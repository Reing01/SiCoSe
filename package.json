{
  "name": "sicose",
  "version": "1.0.0",
  "description": "Sistema web para la digitalizacion y gestion de pagos de servicios publicos en Juntas Auxiliares gubernamentales del estado de Puebla.",
  "main": "index.js",
  "type": "module",
  "packageManager": "npm@10.8.2",
  "scripts": {
    "build": "npm run build --prefix frontend && npm run build --prefix backend",
    "start": "npm run start --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev": "concurrently -c \"cyan,magenta\" \"npm run dev:frontend\" \"npm run dev:backend\"",
    "deploy:cluster:4nodos": "helm upgrade --install sicose ./helm/sicose --namespace sicose-prod --create-namespace -f ./helm/sicose/values-practica-4-nodos.yaml --wait --wait-for-jobs --atomic --timeout 15m",
    "deploy:cluster:4nodos:bootstrap": "node ./scripts/deploy-cluster-4nodos.mjs",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --prefix backend && npm run typecheck --prefix frontend",
    "test": "npm run test --prefix frontend && npm run test --prefix backend",
    "test:e2e": "npm run test:e2e --prefix frontend",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Reing01/SiCoSe.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Reing01/SiCoSe/issues"
  },
  "homepage": "https://github.com/Reing01/SiCoSe#readme",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "concurrently": "^9.2.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "typescript": "^5.8.3"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
