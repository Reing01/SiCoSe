# Docker Compose now carries safe per-service defaults that mirror .env.example
# so a new checkout can run without copying files.
#
# For local overrides, create an untracked .env file and export the variables
# before running Compose, or replace the env_file path locally.


POSTGRES_DB=sicose_dev
POSTGRES_USER=sicose_user
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://sicose_user:change-me@postgres:5432/sicose_dev
DIRECT_URL=postgresql://sicose_user:change-me@postgres:5432/sicose_dev
REDIS_URL=redis://redis:6379
REDIS_APPENDONLY=yes
PORT=3000
CORS_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3000
JWT_SECRET=change-me-in-dev
JWT_ISSUER=sicose
JWT_EXPIRES_IN=8h
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10
RATE_LIMIT_EMAIL_WINDOW_MS=300000
RATE_LIMIT_EMAIL_MAX=5